+++ b/crates/charmera-bake/src/main.rs
@@ -0,0 +1,96 @@
+// Bake spektrafilm into LUTs for the Charmera essay, and render photos for checking them.
+//
+//   charmera-bake lut    <data> <film> <paper|scan> <colour|full> <size> <patch> <out.f32>
+//   charmera-bake render <data> <film> <paper|scan> <colour|full> <w> <h> <in.rgb8> <out.f32>
+//
+// Inputs are 8-bit sRGB; outputs are sRGB-encoded f32, RGB interleaved, red fastest
+// for LUTs (.cube order). "colour" keeps every per-pixel stage plus DIR couplers and
+// switches off grain, halation, glare and sharpening; "full" is spektrafilm's default
+// look. Auto-exposure is off in both, so a LUT and a render see the same exposure.
+use anyhow::{Context, Result, bail};
+use spektrafilm_core::{params::RuntimeParams, pipeline::Pipeline, profile};
+use spektrafilm_math::{image::ImageBuf, precision::{Scalar, from_f32, srgb_decode, to_f32}};
+use std::{path::Path, time::Instant};
+
+fn pipeline(data: &Path, film: &str, paper: &str, mode: &str) -> Result<Pipeline> {
+    let film_p = profile::load_profile_by_name(data, film).context("film profile")?;
+    let scan = paper == "scan";
+    let print_p = profile::load_profile_by_name(data, if scan { film } else { paper }).context("paper profile")?;
+    let mut p = RuntimeParams::default();
+    p.io.scan_film = scan;
+    p.io.input_color_space = "sRGB".into();
+    p.io.input_cctf_decoding = false; // decoded here, as the CLI's PNG loader does
+    p.camera.auto_exposure = false;
+    match mode {
+        "colour" => {
+            p.film_render.grain.active = false;
+            p.film_render.halation.active = false;
+            p.film_render.glare.active = false;
+            p.print_render.glare.active = false;
+            p.scanner.unsharp_mask = [0.0, 0.0];
+        }
+        "pure" => {
+            p.film_render.grain.active = false;
+            p.film_render.halation.active = false;
+            p.film_render.glare.active = false;
+            p.print_render.glare.active = false;
+            p.scanner.unsharp_mask = [0.0, 0.0];
+            p.film_render.dir_couplers.active = false;
+        }
+        "grid" => {
+            p.film_render.grain.active = false;
+            p.film_render.halation.active = false;
+            p.film_render.glare.active = false;
+            p.print_render.glare.active = false;
+            p.scanner.unsharp_mask = [0.0, 0.0];
+            p.film_render.dir_couplers.diffusion_size_um = 0.0;
+            p.film_render.dir_couplers.diffusion_tail_weight = 0.0;
+        }
+        "full" => {}
+        _ => bail!("mode must be colour, pure or full"),
+    }
+    Pipeline::new_with_spectral(film_p, print_p, p, data).map_err(|e| anyhow::anyhow!("{e:?}"))
+}
+
+fn decode(v: u8) -> Scalar { srgb_decode(from_f32(v as f32 / 255.0)) }
+
+fn write_f32(path: &str, img: &ImageBuf) -> Result<()> {
+    let bytes: Vec<u8> = img.data.iter().flat_map(|&v| to_f32(v).to_le_bytes()).collect();
+    std::fs::write(path, bytes).context("writing output")
+}
+
+fn main() -> Result<()> {
+    let a: Vec<String> = std::env::args().collect();
+    let backend = spektrafilm_gpu::select_backend();
+    let t = Instant::now();
+    match a.get(1).map(String::as_str) {
+        Some("lut") => {
+            let (size, patch): (usize, u32) = (a[6].parse()?, a[7].parse()?);
+            let pipe = pipeline(Path::new(&a[2]), &a[3], &a[4], &a[5])?;
+            let mut out = ImageBuf::new((size * size * size) as u32, 1);
+            let mut i = 0;
+            for b in 0..size { for g in 0..size { for r in 0..size {
+                let level = |k: usize| (k as f32 * 255.0 / (size - 1) as f32).round() as u8;
+                let px = [decode(level(r)), decode(level(g)), decode(level(b))];
+                // Each grid colour is a uniform patch, so spatial stages see a flat field.
+                let img = ImageBuf::from_data(patch, patch, px.iter().copied().cycle().take((patch * patch * 3) as usize).collect());
+                let res = pipe.process(img, backend.as_ref());
+                let c = res.get(patch / 2, patch / 2);
+                out.data[i * 3..i * 3 + 3].copy_from_slice(&c);
+                i += 1;
+            }}}
+            write_f32(&a[8], &out)?;
+        }
+        Some("render") => {
+            let (w, h): (u32, u32) = (a[6].parse()?, a[7].parse()?);
+            let pipe = pipeline(Path::new(&a[2]), &a[3], &a[4], &a[5])?;
+            let raw = std::fs::read(&a[8]).context("reading input")?;
+            if raw.len() != (w * h * 3) as usize { bail!("input is not {w}x{h} RGB8"); }
+            let img = ImageBuf::from_data(w, h, raw.iter().map(|&v| decode(v)).collect());
+            write_f32(&a[9], &pipe.process(img, backend.as_ref()))?;
+        }
+        _ => bail!("usage: charmera-bake lut|render ..."),
+    }
+    eprintln!("{} {} {}: {} ms", a[1], a[3], a[5], t.elapsed().as_millis());
+    Ok(())
+}
